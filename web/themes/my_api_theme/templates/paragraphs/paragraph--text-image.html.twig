{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'image-' ~ paragraph.field_image_position.value|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  <div class="paragraph__column paragraph__text">
    {{ content.field_text }}
  </div>
  <div class="paragraph__column paragraph__image">
    {{ content.field_image }}
  </div>
</div>
