<?php

/**
 * @file
 * Primary module hooks for time_log_tracker module.
 */

use Drupal\Core\Url;
use Drupal\Component\Utility\Html;

/**
 * Implements hook_preprocess_node().
 */
function time_log_tracker_preprocess_node(&$variables) {
  $node = $variables['node'];
  if ($node->bundle() === 'project' && $variables['view_mode'] === 'full') {
    $variables['log_time_link'] = [
      '#type' => 'link',
      '#title' => t('Log Time'),
      '#url' => Url::fromRoute('time_log_tracker.log_time', ['project_id' => $node->id()]),
      '#attributes' => [
        'class' => ['button', 'button--primary'],
      ],
    ];
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function time_log_tracker_preprocess_views_view(&$variables) {
  if ($variables['view']->id() === 'kanban_board') {
    $variables['#attached']['library'][] = 'time_log_tracker/kanban';
  }
}

/**
 * Implements hook_preprocess_views_view_grouping().
 */
function time_log_tracker_preprocess_views_view_grouping(&$variables) {
  $view = $variables['view'];
  if ($view->id() === 'kanban_board') {
    $group_content = $variables['title'];
    // Extract TID or name from grouping title.
    // Usually it's a rendered label.
    $term_name = trim(strip_tags((string) $group_content));

    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
      'vid' => 'task_status',
      'name' => $term_name,
    ]);

    if ($terms) {
      $term = reset($terms);
      if ($term->hasField('field_color') && !$term->get('field_color')->isEmpty()) {
        $color = $term->get('field_color')->value;
        $variables['title'] = [
          '#type' => 'html_tag',
          '#tag' => 'div',
          '#value' => $term_name,
          '#attributes' => [
            'style' => 'background-color: ' . Html::escape($color) . ';',
            'class' => ['view-grouping-header'],
          ],
        ];
      }
    }
  }
}
