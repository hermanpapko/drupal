<?php

/**
 * @file
 * Primary module hooks for my_helper module.
 */

declare (strict_types=1);

use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_theme().
 */
function my_helper_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'my_greeting_template' => [
      'variables' => [
        'user_name' => NULL,
        'user_count' => NULL,
        'greeting_text' => NULL,
        'visit_time' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_user_login().
 */
function my_helper_user_login(AccountInterface $account): void {
  \Drupal::service('my_helper.login_handler')->onUserLogin($account);
}

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function my_helper_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Check that this is the Task creation or edit form.
  if ($form_id === 'node_task_form' || $form_id === 'node_task_edit_form') {

    // 1. Change the button text.
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Save Task (Altered!)');
    }

    // 2. Add custom validation.
    $form['#validate'][] = 'my_helper_task_custom_validate';
  }
}

/**
 * Custom validation callback for Task form.
 */
function my_helper_task_custom_validate(&$form, FormStateInterface $form_state) {
  $title = $form_state->getValue('title')[0]['value'] ?? '';

  if (strtolower($title) === 'test') {
    $form_state->setErrorByName('title', t('Please use a more descriptive title than "Test".'));
  }
}
